From 55562d04336e6380fa6a8c3eec54e0787d8cedd9 Mon Sep 17 00:00:00 2001
From: Adam Olech <aolech@antmicro.com>
Date: Thu, 9 Feb 2023 12:36:08 +0100
Subject: [PATCH 4/9] Export variables for Go and Cgo cross-compilation

---
 mconfig                   | 15 ++++++++++++++-
 mlocal/frags/build_cli.mk |  2 +-
 2 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/mconfig b/mconfig
index f9fdad20c..738fcaea0 100755
--- a/mconfig
+++ b/mconfig
@@ -40,6 +40,8 @@ tgtobjcopy=
 hststatic=0
 tgtstatic=0
 
+tgtgoarch=
+
 # user_cflags - user-defined CFLAGS without all the cflags_opts
 user_cflags="$CFLAGS"
 cflags_opts="-Wall -Werror -Wfatal-errors -Wno-unknown-warning-option \
@@ -368,6 +370,12 @@ while [ $# -ne 0 ]; do
      exit
    fi
    hstgo="$2"; shift; shift;;
+  --target-goarch)
+   if ! echo "$2" | awk '/^-.*/ || /^$/ { exit 2 }'; then
+     echo "error: option requires an argument: $1"
+     exit
+   fi
+   tgtgoarch="$2"; shift; shift;;
   -s)
    hststatic=1; shift;;
   -S)
@@ -669,23 +677,28 @@ HOSTOBJCOPY := $hstobjcopy
 
 AR := $tgtar
 CC := $tgtcc
+CC_FOR_linux_$tgtgoarch := $tgtcc
 CXX := $tgtcxx
 LD := $tgtld
 RANLIB := $tgtranlib
 SIZE := size
 OBJCOPY := $tgtobjcopy
+export CC CC_FOR_linux_$tgtgoarch
 
 ARCH := $tgt_arch
 
 CFLAGS := $cflags
 
 GO := $hstgo
+GOARCH := $tgtgoarch
+export GOARCH
 
 CGO_CFLAGS := -I$builddir $CGO_CFLAGS
 CGO_LDFLAGS := $CGO_LDFLAGS
 CGO_CPPFLAGS := $CGO_CPPFLAGS
 CGO_CXXFLAGS := $CGO_CXXFLAGS
-export CGO_CFLAGS CGO_LDFLAGS CGO_CPPFLAGS CGO_CXXFLAGS
+CGO_ENABLED := 1
+export CGO_CFLAGS CGO_LDFLAGS CGO_CPPFLAGS CGO_CXXFLAGS CGO_ENABLED
 EOF
 
 
diff --git a/mlocal/frags/build_cli.mk b/mlocal/frags/build_cli.mk
index ac79b783b..8fdebfa1a 100644
--- a/mlocal/frags/build_cli.mk
+++ b/mlocal/frags/build_cli.mk
@@ -49,7 +49,7 @@ $(bash_completions): $(apptainer_build_config)
 	@echo " GEN" $@
 	$(V)rm -f $@
 	$(V)mkdir -p $(@D)
-	$(V)$(GO) run $(GO_MODFLAGS) -tags "$(GO_TAGS)" \
+	$(V)env -u GOARCH CC=$(HOSTCC) $(GO) run $(GO_MODFLAGS) -tags "$(GO_TAGS)" \
 		$(SOURCEDIR)/cmd/bash_completion/bash_completion.go $@
 
 bash_completion1_INSTALL := $(DESTDIR)$(DATADIR)/bash-completion/completions/apptainer
-- 
2.30.2

